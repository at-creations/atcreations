# Development defaults for the API container (docker-compose.dev.yml).
# These are placeholders, not secrets. Real development keys (Clerk sk_test_,
# R2 dev bucket, SendGrid) go in apps/api/.env, which overrides this file.
APP_ENV=development
LOG_LEVEL=debug
MONGO_DATABASE=atcreations

CLERK_SECRET_KEY=sk_test_placeholder_set_real_key_in_apps_api_env

# Local RustFS (docker-compose.dev.yml). Set S3_* and CDN_BASE_URL in
# apps/api/.env only if you want to use a real R2 bucket instead.
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=atcreations-dev
S3_ACCESS_KEY_ID=atcreations-dev
S3_SECRET_ACCESS_KEY=dev-rustfs-secret-key
# CDN_BASE_URL (where browsers load images) is set in docker-compose.dev.yml
# from DEV_MEDIA_ORIGIN, so it follows the tunnel when one is configured.

MAIL_PROVIDER=log
STORE_NAME=AT Creations (dev)

# Dev-only pepper (production values come from deploy/scripts/init-secrets.sh).
HASH_PEPPER=dev-only-pepper-0123456789abcdef0123456789abcdef

FEATURE_PUBLIC_CHECKOUT=false
# Analytics days are counted in this IANA time zone.
ANALYTICS_TIMEZONE=America/Vancouver
JOBS_ENABLED=true
