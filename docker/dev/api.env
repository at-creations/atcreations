# Development defaults for the API container (docker-compose.dev.yml).
# These are placeholders, not secrets. Real development keys (Clerk sk_test_,
# R2 dev bucket, SendGrid) go in apps/api/.env, which overrides this file.
APP_ENV=development
LOG_LEVEL=debug
MONGO_DATABASE=atcreations

CLERK_SECRET_KEY=sk_test_placeholder_set_real_key_in_apps_api_env
CLERK_INVITE_REDIRECT_URL=http://localhost:5174/sign-in

S3_ENDPOINT=http://r2-not-configured.invalid
S3_REGION=auto
S3_BUCKET=atcreations-dev
S3_ACCESS_KEY_ID=placeholder
S3_SECRET_ACCESS_KEY=placeholder
CDN_BASE_URL=http://cdn-not-configured.invalid

MAIL_PROVIDER=log
STORE_NAME=AT Creations (dev)
STOREFRONT_URL=http://localhost:5173

# Dev-only pepper (production values come from deploy/scripts/init-secrets.sh).
HASH_PEPPER=dev-only-pepper-0123456789abcdef0123456789abcdef

FEATURE_PUBLIC_CHECKOUT=false
JOBS_ENABLED=true
