{
  "name": "atcreations",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev:storefront": "pnpm --filter @atcreations/storefront dev",
    "dev:admin": "pnpm --filter @atcreations/admin dev",
    "gen:api": "pnpm --filter @atcreations/api-types gen",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "pnpm -r format"
  }
}
