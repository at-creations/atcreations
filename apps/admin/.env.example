# Clerk — https://dashboard.clerk.com → API keys
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Server-only. Never prefix with PUBLIC_.
CLERK_SECRET_KEY=sk_test_replace_me
# Optional: disable Clerk telemetry
PUBLIC_CLERK_TELEMETRY_DISABLED=true

# Browser → Go API origin (no trailing slash)
PUBLIC_API_URL=http://localhost:8080
# Storefront origin, used for "View on site" links
PUBLIC_STOREFRONT_URL=http://localhost:5173

# --- Build-time only: Content-Security-Policy origins (read by svelte.config.js) ---
# Extra Clerk Frontend API origins, comma separated (e.g. https://clerk.atcreations.ca).
# The origin encoded in PUBLIC_CLERK_PUBLISHABLE_KEY is always added.
CSP_CLERK_ORIGINS=
# Image CDN origins for product/category images, comma separated
CSP_IMG_ORIGINS=http://localhost:8080
