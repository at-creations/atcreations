# Canonical public origin of the storefront (used for canonical URLs, hreflang, sitemap, OG tags).
PUBLIC_SITE_URL=https://atcreations.ca

# Browser-facing API origin. Used by the client-side product view counter and added to the
# CSP connect-src/img-src at BUILD time (see svelte.config.js).
PUBLIC_API_URL=https://api.atcreations.ca

# Server-side base URL for SSR API calls (e.g. the internal Docker network address).
# Optional: falls back to PUBLIC_API_URL.
API_INTERNAL_URL=http://api:8080

# CDN base for static marketing images (hero.jpg, about_row.jpg, logo-nav.png, ...).
# Its origin is added to the CSP img-src at BUILD time.
PUBLIC_ASSET_BASE_URL=https://cdn.atcreations.ca/site

# Optional, build time: extra img-src origins (space/comma separated), e.g. a separate
# product-image CDN if the API returns image URLs on another host.
# CSP_IMG_ORIGINS=https://images.atcreations.ca
