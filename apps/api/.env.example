# Copy to .env for local development. Never commit real values.
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=debug

# Browser origins (CORS). Public = storefront; admin = admin dashboard
# (admin origins may also call the public API).
CORS_PUBLIC_ORIGINS=http://localhost:5173
CORS_ADMIN_ORIGINS=http://localhost:5174
# Reverse proxies whose X-Forwarded-For is trusted (the Caddy container network in prod)
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Redis (optional in dev: without it rate limits are in-memory and nothing is cached)
REDIS_URL=redis://:dev-redis-password@127.0.0.1:6379/0

# Self-hosted MongoDB (single-node replica set; transactions require a replica set)
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGO_DATABASE=atcreations

# Clerk (https://dashboard.clerk.com → API keys)
CLERK_SECRET_KEY=sk_test_replace_me
# Admin app origin(s); session tokens minted for other origins are rejected
CLERK_AUTHORIZED_PARTIES=http://localhost:5174
CLERK_INVITE_REDIRECT_URL=http://localhost:5174/sign-up

# Cloudflare R2 (S3-compatible). Use a token scoped to this bucket only (Object Read & Write).
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=atcreations-media
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
CDN_BASE_URL=https://cdn.atcreations.ca

# Email: log (dev only) | sendgrid
MAIL_PROVIDER=log
SENDGRID_API_KEY=
MAIL_FROM=orders@atcreations.ca
MAIL_FROM_NAME=AT Creations
STORE_NAME=AT Creations
STOREFRONT_URL=http://localhost:5173

# 32+ random chars: openssl rand -hex 32
HASH_PEPPER=replace_with_openssl_rand_hex_32_output_000000000000

FEATURE_PUBLIC_CHECKOUT=false
# Image worker (go run ./cmd/imgworker with WORKER_TOKEN set to the same value).
IMAGE_WORKER_ADDR=127.0.0.1:9090
IMAGE_WORKER_TOKEN=replace_with_openssl_rand_hex_32_output_000000000000
# Analytics days are counted in this IANA time zone.
ANALYTICS_TIMEZONE=America/Vancouver
JOBS_ENABLED=true
