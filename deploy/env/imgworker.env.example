# Image worker. Needs object storage only. Generated placeholders (__X__) are filled by
# scripts/init-secrets.sh; WORKER_TOKEN must equal IMAGE_WORKER_TOKEN in api.env.
LOG_LEVEL=info
WORKER_TOKEN=__IMAGE_WORKER_TOKEN__
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=atcreations-media
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
# Optional folder for every object (e.g. atcreations) when the bucket is shared with another app.
S3_KEY_PREFIX=
