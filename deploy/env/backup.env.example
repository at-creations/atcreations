# Settings for scripts/backup.sh. Copy to env/backup.env on the server.

# age public key (age1...). Backups are encrypted to it; keep the matching private key
# off the server (password manager / offline). Generate with: age-keygen -o backup.key
BACKUP_AGE_RECIPIENT=

# Optional off-host copy with rclone (configure the remote with `rclone config` first,
# ideally with a write-only token so the server cannot delete old backups).
BACKUP_RCLONE_REMOTE=

# Days of backups kept on the server.
KEEP_DAYS=14
